# ── Local development needs NO database configuration ────────────────────
# Just run `npm run dev`: the app uses an embedded PGlite database in ./.pglite
# and creates/updates its tables and catalog automatically.
#
# Optional — use an external PostgreSQL instead (Neon, Supabase, ...).
# DATABASE_URL=postgresql://user:password@host.example.com/db?sslmode=require
#
# ── Session and authentication secrets ───────────────────────────────────
# Generate each key independently with: openssl rand -hex 32
# SESSION_SECRET signs anonymous cart cookies. Required in production.
SESSION_SECRET=
# AUTH_SECRET protects six-digit verification-code digests and auth rate-limit
# keys. Required in production; development uses an ephemeral process key.
AUTH_SECRET=
#
# APP_ORIGIN must be the exact public origin (no path) in production and must
# match the public Preview origin for that environment.
# APP_ORIGIN=https://shop.example.com
# Set true only when your reverse proxy overwrites X-Forwarded-For. Without a
# trusted IP header, auth still rate-limits per email; cart/checkout use a
# conservative shared fallback bucket.
# TRUST_PROXY_IP_HEADERS=true
#
# ── Google OpenID Connect (optional until configured) ────────────────────
# Create OAuth 2.0 Web application credentials in Google Cloud Console.
# Add ${APP_ORIGIN}/api/auth/google/callback as an authorized redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# ── Real SMTP delivery for email verification (optional until configured) ─
# All fields are required; the app never displays or logs verification codes.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=E-Vora <verify@example.com>
# SMTP_SECURE=false
#
# ── Destructive PostgreSQL integration tests (test databases only) ────────
# Tests refuse production and require a local database name ending in _test.
# Never point TEST_DATABASE_URL at production or shared data.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/evora_test
# Remote targets require an explicit, risky opt-in and the same _test suffix.
# ALLOW_REMOTE_TEST_DATABASE=YES
