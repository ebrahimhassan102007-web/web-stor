# PostgreSQL connection string (the only supported database engine).
# Required — there is no embedded/fallback database, so startup fails closed
# when it is missing or not a PostgreSQL URL.
DATABASE_URL=postgres://user:password@host:5432/webstor
# 32+ byte random hex secret used to HMAC-sign session cookies (openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-secret

# Exact public origin used to validate state-changing requests (CSRF defense).
# Required in production: without it, POST/PATCH/DELETE API calls are rejected.
# Example: https://store.example.com
# APP_ORIGIN=https://store.example.com

# Only set to true behind a trusted proxy that OVERWRITES X-Forwarded-For.
# When false (default), forwarded headers are ignored and all clients share a
# single conservative rate-limit bucket.
# TRUST_PROXY_IP_HEADERS=false
