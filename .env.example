# ============================================================================
# خدمتك ستور | Khodmtak Store — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================================

# --- Database (required) ----------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/webstor

# --- Secrets (required) -----------------------------------------------------
# Session cookie signing/derivation secret. Generate: openssl rand -hex 32
SESSION_SECRET=

# Encryption key for digital codes at rest (AES-256-GCM key derivation).
# MUST be different from SESSION_SECRET. Generate: openssl rand -hex 32
# Rotating this key makes previously stored codes unreadable — plan rotation.
INVENTORY_SECRET=

# HMAC secret for payment-callback signatures. Falls back to SESSION_SECRET
# when unset; set a dedicated value in production.
PAYMENT_WEBHOOK_SECRET=

# --- Admin bootstrap (required by `npm run db:seed`) ------------------------
# The seed script creates/updates this admin account. Password >= 10 chars.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Providers ---------------------------------------------------------------
# Payment provider driver. "mock" is the DEVELOPMENT simulator; it refuses to
# run in production unless ALLOW_MOCK_PAYMENTS=true is set explicitly.
# Production: implement/select a real provider (e.g. Stripe) — see README.
PAYMENT_PROVIDER=mock

# Explicit production opt-ins for the clearly-marked mock providers.
# Leave UNSET in any real deployment.
# ALLOW_MOCK_PAYMENTS=true
# ALLOW_MOCK_PROVIDERS=true

# --- Site --------------------------------------------------------------------
# Canonical origin used in sitemap/robots/OG metadata.
NEXT_PUBLIC_SITE_URL=https://khodmtak.store

# --- External services (not yet configured — required for production) --------
# Stripe (real payments):        STRIPE_SECRET_KEY=, STRIPE_WEBHOOK_SECRET=
# Game top-up provider API:      TOPUP_API_URL=, TOPUP_API_KEY=
# Mobile recharge provider API:  RECHARGE_API_URL=, RECHARGE_API_KEY=
# Transactional email (SMTP):    SMTP_HOST=, SMTP_PORT=, SMTP_USER=, SMTP_PASS=
