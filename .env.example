# ── Required runtime database ─────────────────────────────────────────────
# E-Vora uses external PostgreSQL in every runtime environment. There is no
# embedded/fallback database. Use a local disposable database for development;
# never use the live Neon catalogue for setup, tests, or migration rehearsals.
DATABASE_URL=postgresql://user:password@localhost:5432/evora_test
#
# Apply the reviewed SQL history explicitly before starting the app:
#   npm run db:migrate
# Optional additive demo catalogue seed (after migrating):
#   npm run db:seed
# The app never migrates or seeds automatically at startup.
#
# Optional Drizzle Kit target override for schema tooling. Use only an
# intentionally selected disposable database; db:push is not an upgrade path.
# DRIZZLE_KIT_DATABASE_URL=postgresql://user:password@localhost:5432/evora_test
#
# ── Session and authentication secrets ───────────────────────────────────
# Generate each key independently with: openssl rand -hex 32
# SESSION_SECRET signs anonymous cart cookies. Required in production.
SESSION_SECRET=
# AUTH_SECRET protects six-digit verification-code digests and auth rate-limit
# keys. Required in production; development uses an ephemeral process key.
AUTH_SECRET=
#
# APP_ORIGIN must be the exact public origin (no path) in production and must
# match the public Preview origin for that environment.
# APP_ORIGIN=https://shop.example.com
# Set true only when your reverse proxy overwrites X-Forwarded-For. Without a
# trusted IP header, auth still rate-limits per email; cart/checkout use a
# conservative shared fallback bucket.
# TRUST_PROXY_IP_HEADERS=true
#
# ── Google OpenID Connect (optional until configured) ────────────────────
# Create OAuth 2.0 Web application credentials in Google Cloud Console.
# Add ${APP_ORIGIN}/api/auth/google/callback as an authorized redirect URI.
# Without these values Google sign-in is honestly unavailable, not simulated.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# ── Real SMTP delivery for email verification (optional until configured) ─
# All fields are required; the app never displays or logs verification codes.
# Without a complete SMTP configuration, verification-dependent email auth
# reports that delivery is unavailable instead of claiming to be live.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=E-Vora <verify@example.com>
# SMTP_SECURE=false
#
# ── Explicit migration confirmations ─────────────────────────────────────
# Remote migration commands are refused by default. Set only after checking
# the target and rehearsing on a restored disposable copy.
# ALLOW_REMOTE_MIGRATION=YES
# Production additionally requires both of these after a verified backup and
# restore test. They are never needed by local development or CI.
# ALLOW_PRODUCTION_MIGRATION=YES
# CONFIRM_PRODUCTION_BACKUP=YES
# Remote additive seeding has its own opt-in and is always refused in production.
# ALLOW_REMOTE_SEED=YES
#
# Optional public support address shown on /contact. Keep unset until a real inbox is available.
# SUPPORT_EMAIL=support@example.com

# ── Destructive PostgreSQL integration tests (test databases only) ────────
# Tests refuse production and require a local database name ending in _test.
# Never point TEST_DATABASE_URL at production or shared data.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/evora_test
# Remote targets require an explicit, risky opt-in and the same _test suffix.
# ALLOW_REMOTE_TEST_DATABASE=YES
